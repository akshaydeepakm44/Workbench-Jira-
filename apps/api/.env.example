DATABASE_URL="file:./dev.db"
PORT=3000
BOOTSTRAP_MANAGER_EMAIL="manager@company.com"
SESSION_SECRET="workdesk-session-secret-production-grade-random-32"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"
NODE_ENV="development"
GOOGLE_ALLOWED_DOMAIN="company.com"
GOOGLE_CLIENT_ID="dev-google-client-id"
GOOGLE_CLIENT_SECRET="dev-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"
# App URL (Use localhost or nip.io wildcard DNS e.g. http://192.168.0.4.nip.io:5174 or http://127.0.0.1.nip.io:5174)
APP_URL="http://192.168.0.4.nip.io:5174"

# Real SMTP Email Configuration (Gmail / Google Workspace / Custom SMTP)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_SERVICE="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_FROM="WorkDesk Platform <your-email@gmail.com>"
